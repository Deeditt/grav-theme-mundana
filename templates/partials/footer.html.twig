<!-- Footer -->
<style>
    footer .list-unstyled {
        font-size: 1rem !important;
	font-family: inherit;
    }
</style>
<footer class="bg-white border-top pt-5 pb-3 text-muted small">
    <div class="{{ containerClass }}">
        <div class="row">
            {# Column 1: Get in Touch #}
            <div class="col-12 col-md-6 col-lg-3 mb-4">
                <h5 class="font-weight-bold mb-3 text-dark">Get in Touch</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a title="Contact Us" href="https://deeditt.com/get-in-touch" class="text-muted">Contact Us</a></li>
                    <li class="mb-2"><a title="Releases" href="https://deeditt.com/changelog" class="text-muted">Releases</a></li>
                </ul>
                {# Social icons #}
                <div class="social-icons mt-3">
                    <a href="https://twitter.com/youdeeditt" class="text-muted mr-3" aria-label="Twitter" target="_blank"><i class="fab fa-twitter fa-lg"></i></a>
                    <a href="https://www.facebook.com/profile.php?id=61555329880264" class="text-muted mr-3" aria-label="Facebook" target="_blank"><i class="fab fa-facebook fa-lg"></i></a>
                    <a href="https://www.instagram.com/youdeeditt" class="text-muted mr-3" aria-label="Instagram" target="_blank"><i class="fab fa-instagram fa-lg"></i></a>
                </div>
            </div>

            {# Column 2: Resources #}
            <div class="col-12 col-md-6 col-lg-2 mb-4">
                <h5 class="font-weight-bold mb-3 text-dark">Resources</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a title="Collaboration" href="https://deeditt.com/collaboration" class="text-muted">Collaboration</a></li>
                    <li class="mb-2"><a title="FAQs" href="https://deeditt.com/faqs" class="text-muted">FAQs</a></li>
                </ul>
            </div>

            {# Column 3: About Deeditt #}
            <div class="col-12 col-md-6 col-lg-2 mb-4">
                <h5 class="font-weight-bold mb-3 text-dark">About Deeditt</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a title="About Us" href="https://deeditt.com/about" class="text-muted">About Us</a></li>
                    <li class="mb-2"><a title="Our Essence" href="https://deeditt.com/spirit" class="text-muted">Our Essence</a></li>
                    <li class="mb-2"><a title="Manifest" href="https://deeditt.com/manifest" class="text-muted">Manifest</a></li>
                </ul>
            </div>

            {# Column 4: Explore More #}
            <div class="col-12 col-md-6 col-lg-2 mb-4">
                <h5 class="font-weight-bold mb-3 text-dark">Explore More</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a title="Terms" href="https://deeditt.com/terms" class="text-muted">Terms</a></li>
                    <li class="mb-2"><a title="Privacy" href="https://deeditt.com/privacy" class="text-muted">Privacy</a></li>
                    <li class="mb-2"><a title="Guidelines" href="https://deeditt.com/guidelines" class="text-muted">Guidelines</a></li>
                </ul>
            </div>

            {# Column 5: Download Deeditt #}
            <div class="col-12 col-lg-3 mb-4">
                <h5 class="font-weight-bold mb-3 text-dark">Download Deeditt</h5>
                <div class="d-flex flex-column">
                    <a title="Download on App Store" href="https://apps.apple.com/us/app/deeditt/id6563138755" class="mb-2" target="_blank">
                        <img src="https://s3.amazonaws.com/assets.deeditt.com/android-google-play-store-VTzL25mTrHWiAnYDu8HKk0WyX.webp" alt="Get it on Google Play" style="height: 40px; width: auto;">
                    </a>
                    <a title="Get it on Google Play" href="https://play.google.com/store/apps/details?id=com.deeditt.mobile" target="_blank">
                        <img src="https://s3.amazonaws.com/assets.deeditt.com/ios-app-store-VTzL25mTrHWiAnYDu8HKk0WyX.webp" alt="Download on App Store" style="height: 40px; width: auto;">
                    </a>
                </div>
                {# Language toggle - if langswitcher enabled #}
                {% if config.plugins.langswitcher.enabled %}
                <div class="mt-3">
                    <small class="text-muted d-block mb-1">Language</small>
                    <select class="form-control form-control-sm" onchange="window.location.href=this.value">
                        {% embed 'partials/langswitcher-logic.html.twig' %}
                            {% block language_block_start %}{% endblock %}
                            {% block language_block_end %}{% endblock %}
                            {% block language_item %}
                                {% if show_language %}
                                <option value="{{ lang_url ~ uri.params }}" {{ language == langswitcher.current ? 'selected' : '' }}>
                                    {{ language|upper }}
                                </option>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </select>
                </div>
                {% endif %}
            </div>
        </div>

        {# Bottom row - copyright #}
        <div class="row mt-4 pt-3 border-top">
            <div class="col-12 text-center">
                <small>&copy; {{ 'now'|date('Y') }} {{ site.title|e }}. All rights reserved.</small>
            </div>
        </div>
    </div>
</footer>
