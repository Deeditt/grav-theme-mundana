<div class="mb-5 row d-lg-flex justify-content-between">
    <div class="col-12 order-2 order-md-1 mt-4 mt-sm-0 col-sm-8">
        {# Page post title #}
        <{{ title_level }} class="font-weight-bold mb-1">
        <a class="text-dark" href="{{ page.url }}">{{ page_title|e }}</a>
        </{{ title_level }}>
	{# Page subtitle #}
        {% if page.header.subtitle %}
        <p class="text-muted mb-2">{{ page.header.subtitle|markdown(false) }}</p>
        {% endif %}
        {# If summary is enabled it will displayed #}
        {% if page.header.summary.enabled ?? true %}
            {{ include('partials/blog/page-summary.html.twig') }}
        {% endif %}
        {# Show categories #}
        <small class="d-block text-muted">
            {{ 'MUNDANA.MISC.IN'|t }} <span class="catlist">
            {% for category in page.taxonomy.category %}
                <a class="text-capitalize text-{{ color_style }} smoothscroll" href="{{ blog.url }}/category{{ config.system.param_sep }}{{ category|e('url') }}">{{ category|e }}</a>{% if not loop.last %}<span class="sep">, </span>{% endif %}
            {% endfor %}
            </span>
        </small>
        {# Show post date #}
        <small class="d-block text-muted">
            {{ include('partials/blog/date.html.twig') }}
        </small>
	{# Show tags #}
        {% if page.taxonomy.tag %}
        <small class="d-block mt-2">
            {% for tag in page.taxonomy.tag %}
                <a class="badge badge-{{ color_style }} text-capitalize" href="{{ blog.url }}/tag{{ config.system.param_sep }}{{ tag|e('url') }}">{{ tag|e }}</a>{% if not loop.last %} {% endif %}
            {% endfor %}
        </small>
        {% endif %}
        {# Read more link #}
        <small class="d-block mt-2">
            <a href="{{ page.url }}" class="text-{{ color_style }} font-weight-bold">Read article →</a>
        </small>
    </div>
    {# Show featured image if it's defined and show_image is true #}
    {% if featuredImage and show_image %}
    <div class="col-12 mt-0 col-sm-4 mt-0 mt-sm-0 text-lg-end">
        <a href="{{ page.url }}" aria-label="{{ page_title|e('html_attr') }}">
            {{ featuredImage.loading(loadLazy ? 'lazy' : 'eager')
            .decoding('async')
            .attribute('width', '424')
            .attribute('height', '318')
            .derivatives(320, 424, 320)
            .sizes('(max-width: 768px) 100vw, 50vw')
            .html(page_title, page_title, 'w-100 h-auto rounded')|raw }}
        </a>
    </div>
    {% endif %}
</div>
